{
  "name": "proactive-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bash scripts/publish-proactive.sh --build-only",
    "typecheck": "bun run --filter='@proactive-agent/core' typecheck; bun run --filter='@proactive-agent/mcp' typecheck; true",
    "test": "bun test --parallel 1"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@types/bun": "latest",
    "typescript": "^5.0.0"
  }
}
