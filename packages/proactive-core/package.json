{
  "name": "@proactive-agent/core",
  "version": "0.10.0",
  "license": "MIT",
  "description": "ProactiveAgent headless engine: proactive memory (capture/recall/persona/scene) + proactive suggestions. Host-agnostic, zero-dependency bundle.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./memory": "./src/memory/service.ts",
    "./suggest": "./src/suggest/service.ts",
    "./paths": "./src/paths.ts",
    "./provider": "./src/provider.ts",
    "./memory/*": "./src/memory/*.ts",
    "./suggest/*": "./src/suggest/*.ts"
  },
  "files": ["dist", "README.md", "LICENSE", "NOTICE"],
  "engines": { "node": ">=18" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run src/memory src/suggest",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --banner:js='#!/usr/bin/env node' --outfile=dist/index.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  }
}
