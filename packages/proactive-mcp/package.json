{
  "name": "@proactive-agent/mcp",
  "version": "0.1.0",
  "license": "MIT",
  "description": "ProactiveAgent MCP Server: proactive memory + suggestions as pluggable MCP tools/resources/prompts for any MCP-capable agent (Claude Code, Kimi Code, Cline, Cursor).",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "proactive-mcp": "./src/index.ts"
  },
  "files": ["dist", "README.md", "LICENSE", "NOTICE"],
  "engines": { "node": ">=18" },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@proactive-agent/core": "workspace:*",
    "zod": "^4.3.6"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "start": "bun run src/index.ts",
    "test": "bun test src/",
    "build": "bun build src/index.ts --target=node --banner '#!/usr/bin/env node' --outfile=dist/index.js"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.0.0"
  }
}
