{
  "name": "@proactive-agent/mcp",
  "version": "0.9.2",
  "license": "MIT",
  "description": "ProactiveAgent MCP Server: proactive memory + suggestions as pluggable MCP tools/resources/prompts for any MCP-capable agent (Claude Code, Kimi Code, Cline, Cursor).",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "proactive-mcp": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@proactive-agent/adapters": "file:../proactive-adapters",
    "@proactive-agent/core": "file:../proactive-core",
    "zod": "^4.3.6"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "start": "node --experimental-strip-types src/index.ts",
    "test": "vitest run src/",
    "build": "node ../../scripts/build-mcp.js",
    "build:hooks": "bash ../../scripts/build-hooks.sh"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  }
}